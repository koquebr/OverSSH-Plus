#!/bin/bash
clear

C_RESET="\033[0m"
C_CYAN="\033[1;36m"
C_GREEN="\033[1;32m"
C_YELLOW="\033[1;33m"
C_RED="\033[1;31m"
C_WHITE="\033[1;37m"

mkdir -p /etc/SSHPlus/senha >/dev/null 2>&1

echo -e "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
echo -e "${C_CYAN}                   >>> ALTERAR SENHA DE USUÁRIO <<<              ${C_RESET}"
echo -e "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}\n"

_userT=$(awk -F: '$3 >= 500 {print $1}' /etc/passwd | grep -v 'nobody' | grep -vi polkitd | grep -vi system- | sort)
i=0
unset _userPass

while read -r _user; do
    [[ -z "$_user" ]] && continue
    i=$((i + 1))
    _oP=$i
    if [[ -f "/etc/SSHPlus/senha/$_user" ]]; then
        _senha=$(cat "/etc/SSHPlus/senha/$_user" 2>/dev/null)
    else
        _senha="*****"
    fi
    printf "  ${C_CYAN}[%02d]${C_RESET} ${C_WHITE}•${C_RESET} ${C_YELLOW}%-18s${C_RESET} ${C_GREEN}Senha Atual:${C_RESET} ${C_WHITE}%s${C_RESET}\n" "$i" "$_user" "$_senha"
    _userPass+="\n${_oP}:${_user}"
done <<< "${_userT}"

if [[ "$i" -eq 0 ]]; then
    echo -e "  ${C_RED}Nenhum usuário cadastrado no sistema.${C_RESET}\n"
    echo -ne "${C_YELLOW}Pressione [ENTER] para voltar: ${C_RESET}"; read -r
    menu
    exit 0
fi

echo -e "\n${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
echo -ne "${C_GREEN}Digite o número ou nome do usuário: ${C_WHITE}"
read -r option

if [[ "$option" =~ ^[0-9]+$ ]]; then
    user=$(echo -e "${_userPass}" | grep -E "^${option}:" | cut -d: -f2)
else
    user="$option"
fi

if [[ -n "$user" ]] && grep -qw "$user" /etc/passwd 2>/dev/null; then
    echo -ne "${C_GREEN}Nova senha para ${C_YELLOW}$user${C_GREEN}: ${C_WHITE}"
    read -r password
    if [[ -z "$password" || ${#password} -lt 3 ]]; then
        echo -e "\n${C_RED}[!] Senha muito curta ou vazia (mínimo 3 caracteres).${C_RESET}\n"
    else
        (echo "$password"; echo "$password") | passwd "$user" >/dev/null 2>&1
        echo "$password" > "/etc/SSHPlus/senha/$user"
        echo -e "\n${C_GREEN}[✓] Senha do usuário '$user' alterada com sucesso para: $password${C_RESET}\n"
    fi
else
    echo -e "\n${C_RED}[!] Usuário não encontrado ou opção inválida.${C_RESET}\n"
fi

sleep 2s
menu
