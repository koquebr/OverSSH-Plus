#!/bin/bash
#====================================================
# OVER SSH PLUS - GERENCIADOR AUTO LIMITER (ON / OFF)
#====================================================
clear

C_RESET="\033[0m"
C_CYAN="\033[1;36m"
C_GREEN="\033[1;32m"
C_YELLOW="\033[1;33m"
C_RED="\033[1;31m"
C_WHITE="\033[1;37m"

fun_bar() {
    comando[0]="$1"
    comando[1]="$2"
    (
        [[ -e $HOME/fim ]] && rm -f $HOME/fim
        ${comando[0]} >/dev/null 2>&1
        ${comando[1]} >/dev/null 2>&1
        touch $HOME/fim
    ) >/dev/null 2>&1 &
    tput civis
    echo -ne "   ${C_YELLOW}AGUARDE ${C_WHITE}- ${C_CYAN}["
    while true; do
        for ((i = 0; i < 18; i++)); do
            echo -ne "${C_GREEN}#"
            sleep 0.06s
        done
        [[ -e $HOME/fim ]] && rm -f $HOME/fim && break
        echo -e "${C_CYAN}]"
        sleep 1s
        tput cuu1
        tput dl1
        echo -ne "   ${C_YELLOW}AGUARDE ${C_WHITE}- ${C_CYAN}["
    done
    echo -e "${C_CYAN}]${C_WHITE} - ${C_GREEN}OK !${C_RESET}"
    tput cnorm
}

start_limiter() {
    clear
    echo -e "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
    echo -e "${C_GREEN}           ATIVAR LIMITER AUTOMÁTICO MULTILOGIN     ${C_RESET}"
    echo -e "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}\n"

    fun_start_proc() {
        pkill -f "sshlimiter" >/dev/null 2>&1
        screen -r -S "sshlimiter" -X quit >/dev/null 2>&1
        screen -wipe >/dev/null 2>&1
        sleep 1
        screen -dmS sshlimiter bash /bin/sshlimiter
        
        sed -i '/sshlimiter/d' /etc/autostart 2>/dev/null
        echo "pgrep -f sshlimiter >/dev/null || screen -dmS sshlimiter bash /bin/sshlimiter" >> /etc/autostart
    }

    echo -e "${C_CYAN}[+] Iniciando monitor de limites em segundo plano...${C_RESET}"
    fun_bar 'fun_start_proc'

    echo -e "\n${C_GREEN}[✓] AUTO LIMITER ATIVADO COM SUCESSO!${C_RESET}"
    echo -e "${C_WHITE}Usuários que ultrapassarem o limite simultâneo serão desconectados automaticamente.${C_RESET}\n"
    sleep 2s
}

stop_limiter() {
    clear
    echo -e "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
    echo -e "${C_RED}           DESATIVAR LIMITER AUTOMÁTICO             ${C_RESET}"
    echo -e "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}\n"

    fun_stop_proc() {
        pkill -f "sshlimiter" >/dev/null 2>&1
        pkill -f "droplimiter" >/dev/null 2>&1
        screen -r -S "sshlimiter" -X quit >/dev/null 2>&1
        screen -r -S "limiter" -X quit >/dev/null 2>&1
        screen -wipe >/dev/null 2>&1
        sed -i '/sshlimiter/d' /etc/autostart 2>/dev/null
        sed -i '/droplimiter/d' /etc/autostart 2>/dev/null
    }

    echo -e "${C_YELLOW}[+] Parando monitor de limites...${C_RESET}"
    fun_bar 'fun_stop_proc'

    echo -e "\n${C_RED}[✓] AUTO LIMITER DESATIVADO COM SUCESSO!${C_RESET}\n"
    sleep 2s
}

while true; do
    clear
    status_lim=$(pgrep -f "sshlimiter\|droplimiter" >/dev/null && echo -e "${C_GREEN}● ATIVADO [ON]${C_RESET}" || echo -e "${C_RED}○ DESATIVADO [OFF]${C_RESET}")

    echo -e "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
    echo -e "${C_GREEN}         AUTO LIMITER - CONTROLE DE MULTILOGIN      ${C_RESET}"
    echo -e "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
    echo -e "  ${C_WHITE}Status Atual:${C_RESET} $status_lim\n"
    echo -e "  ${C_CYAN}[01]${C_RESET} ${C_WHITE}•${C_RESET} ${C_GREEN}ATIVAR LIMITER AUTOMÁTICO${C_RESET}"
    echo -e "  ${C_CYAN}[02]${C_RESET} ${C_WHITE}•${C_RESET} ${C_RED}DESATIVAR LIMITER AUTOMÁTICO${C_RESET}"
    echo -e "  ${C_CYAN}[00]${C_RESET} ${C_WHITE}•${C_RESET} ${C_YELLOW}VOLTAR AO MENU PRINCIPAL${C_RESET}"
    echo -e "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
    echo -ne "${C_GREEN}Opção: ${C_WHITE}"
    read -r opclim

    case $opclim in
        1|01) start_limiter ;;
        2|02) stop_limiter ;;
        0|00) menu; exit 0 ;;
        *) echo -e "\n${C_RED}Opção inválida!${C_RESET}"; sleep 1s ;;
    esac
done
