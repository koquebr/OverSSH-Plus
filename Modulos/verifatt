#!/bin/bash
#====================================================
# OVER SSH PLUS - VERIFICADOR DE ATUALIZAÇÃO GITHUB
#====================================================
REPO_CONFIG="/etc/SSHPlus/repo.conf"
DEFAULT_REPO="koquebr/OverSSH-Plus"

stored_repo=""
[[ -f "$REPO_CONFIG" ]] && stored_repo=$(cat "$REPO_CONFIG" 2>/dev/null | tr -d '\r\n ')

if [[ -z "$stored_repo" || "$stored_repo" =~ SSHPLUS || "$stored_repo" =~ crazy_ssh ]]; then
    stored_repo="https://github.com/koquebr/OverSSH-Plus"
fi

if [[ "$stored_repo" =~ github\.com/([^/]+)/([^/]+) ]]; then
    user="${BASH_REMATCH[1]}"
    repo="${BASH_REMATCH[2]}"
    repo=$(echo "$repo" | sed 's#/.*##')
elif [[ "$stored_repo" =~ raw\.githubusercontent\.com/([^/]+)/([^/]+) ]]; then
    user="${BASH_REMATCH[1]}"
    repo="${BASH_REMATCH[2]}"
    repo=$(echo "$repo" | sed 's#/.*##')
elif [[ "$stored_repo" =~ ^([^/]+)/([^/]+)$ ]]; then
    user="${BASH_REMATCH[1]}"
    repo="${BASH_REMATCH[2]}"
else
    user="koquebr"
    repo="OverSSH-Plus"
fi

RAW_MAIN="https://raw.githubusercontent.com/${user}/${repo}/main/Install/versao"
RAW_MASTER="https://raw.githubusercontent.com/${user}/${repo}/master/Install/versao"

rm -f /tmp/att /tmp/versao_remote >/dev/null 2>&1

# Tenta baixar do branch main ou master
curl -sSL --connect-timeout 5 "$RAW_MAIN" -o /tmp/versao_remote >/dev/null 2>&1 || \
curl -sSL --connect-timeout 5 "$RAW_MASTER" -o /tmp/versao_remote >/dev/null 2>&1 || \
wget -q -T 5 -O /tmp/versao_remote "$RAW_MAIN" >/dev/null 2>&1 || \
wget -q -T 5 -O /tmp/versao_remote "$RAW_MASTER" >/dev/null 2>&1

if [[ -s "/tmp/versao_remote" ]]; then
    vrs_local=$(head -n1 /bin/versao 2>/dev/null | tr -cd '0-9.')
    vrs_remota=$(head -n1 /tmp/versao_remote 2>/dev/null | tr -cd '0-9.')

    [[ -z "$vrs_local" ]] && vrs_local="0.0.0.0"
    [[ -z "$vrs_remota" ]] && vrs_remota="0.0.0.0"

    # Comparacao de versao usando sort -V
    if [[ "$vrs_local" != "$vrs_remota" ]]; then
        maior=$(printf "%s\n%s\n" "$vrs_local" "$vrs_remota" | sort -V | tail -n1)
        if [[ "$maior" == "$vrs_remota" && "$vrs_local" != "$vrs_remota" ]]; then
            cp -f /tmp/versao_remote /tmp/att
        fi
    fi
fi
rm -f /tmp/versao_remote >/dev/null 2>&1
