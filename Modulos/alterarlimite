#!/bin/bash
clear

C_RESET="\033[0m"
C_CYAN="\033[1;36m"
C_GREEN="\033[1;32m"
C_YELLOW="\033[1;33m"
C_RED="\033[1;31m"
C_WHITE="\033[1;37m"

database="/root/usuarios.db"
[[ ! -f "$database" ]] && touch "$database"

echo -e "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
echo -e "${C_CYAN}             >>> ALTERAR LIMITE DE CONEXÕES SIMULTÂNEAS <<<       ${C_RESET}"
echo -e "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}\n"

_userT=$(awk -F: '$3 >= 500 {print $1}' /etc/passwd | grep -v 'nobody' | grep -vi polkitd | grep -vi system- | sort)
i=0
unset _userPass

while read -r _user; do
    [[ -z "$_user" ]] && continue
    i=$((i + 1))
    _oP=$i
    if grep -qw "$_user" "$database"; then
        limit=$(grep -w "$_user" "$database" | awk '{print $2}')
    else
        limit="1"
    fi
    printf "  ${C_CYAN}[%02d]${C_RESET} ${C_WHITE}•${C_RESET} ${C_YELLOW}%-18s${C_RESET} ${C_GREEN}Limite Atual:${C_RESET} ${C_WHITE}%s${C_RESET}\n" "$i" "$_user" "$limit"
    _userPass+="\n${_oP}:${_user}"
done <<< "${_userT}"

if [[ "$i" -eq 0 ]]; then
    echo -e "  ${C_RED}Nenhum usuário cadastrado no sistema.${C_RESET}\n"
    echo -ne "${C_YELLOW}Pressione [ENTER] para voltar: ${C_RESET}"; read -r
    menu
    exit 0
fi

echo -e "\n${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
echo -ne "${C_GREEN}Digite o número ou nome do usuário: ${C_WHITE}"
read -r option

if [[ "$option" =~ ^[0-9]+$ ]]; then
    usuario=$(echo -e "${_userPass}" | grep -E "^${option}:" | cut -d: -f2)
else
    usuario="$option"
fi

if [[ -n "$usuario" ]] && grep -qw "$usuario" /etc/passwd 2>/dev/null; then
    echo -ne "${C_GREEN}Novo limite para ${C_YELLOW}$usuario${C_GREEN} [1]: ${C_WHITE}"
    read -r sshnum
    [[ -z "$sshnum" || ! "$sshnum" =~ ^[0-9]+$ || "$sshnum" -lt 1 ]] && sshnum="1"

    sed -i "/^$usuario[[:space:]]/d" "$database" 2>/dev/null
    echo "$usuario $sshnum" >> "$database"
    echo -e "\n${C_GREEN}[✓] Limite do usuário '$usuario' atualizado para $sshnum conexão(ões)!${C_RESET}\n"
else
    echo -e "\n${C_RED}[!] Usuário não encontrado ou opção inválida.${C_RESET}\n"
fi

sleep 2s
menu
