#!/bin/bash
clear

C_RESET="\033[0m"
C_CYAN="\033[1;36m"
C_GREEN="\033[1;32m"
C_YELLOW="\033[1;33m"
C_RED="\033[1;31m"
C_WHITE="\033[1;37m"

IP=$(cat /etc/IP 2>/dev/null || curl -s4 icanhazip.com)
mkdir -p /etc/SSHPlus/userteste /etc/SSHPlus/senha >/dev/null 2>&1

echo -e "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
echo -e "${C_CYAN}              >>> CRIAR USUÁRIO TEMPORÁRIO (TESTE) <<<           ${C_RESET}"
echo -e "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}\n"

testes_ativos=$(ls /etc/SSHPlus/userteste 2>/dev/null | wc -l)
if [[ "$testes_ativos" -gt 0 ]]; then
    echo -e "  ${C_GREEN}Testes Ativos (${testes_ativos}):${C_RESET} ${C_YELLOW}$(ls /etc/SSHPlus/userteste | sed 's/.sh//g' | xargs)${C_RESET}\n"
else
    echo -e "  ${C_WHITE}Nenhum usuário teste ativo no momento.${C_RESET}\n"
fi

echo -ne "${C_GREEN}Nome do usuário teste: ${C_WHITE}"
read -r nome
if [[ -z "$nome" || ! "$nome" =~ ^[a-zA-Z0-9_]+$ ]]; then
    echo -e "\n${C_RED}[!] Nome de usuário vazio ou com caracteres inválidos.${C_RESET}\n"
    sleep 2s
    menu
    exit 1
fi

if grep -qw "$nome" /etc/passwd 2>/dev/null; then
    echo -e "\n${C_RED}[!] Este usuário já existe no sistema.${C_RESET}\n"
    sleep 2s
    menu
    exit 1
fi

echo -ne "${C_GREEN}Senha para o teste: ${C_WHITE}"
read -r pass
[[ -z "$pass" ]] && pass="1234"

echo -ne "${C_GREEN}Limite de conexões simultâneas [1]: ${C_WHITE}"
read -r limit
[[ -z "$limit" ]] && limit="1"

echo -ne "${C_GREEN}Duração em minutos [Ex: 60]: ${C_WHITE}"
read -r u_temp
[[ -z "$u_temp" ]] && u_temp="60"

useradd -M -s /bin/false "$nome" >/dev/null 2>&1
(echo "$pass"; echo "$pass") | passwd "$nome" >/dev/null 2>&1
echo "$pass" > "/etc/SSHPlus/senha/$nome"
echo "$nome $limit" >> /root/usuarios.db

cat << EOF > "/etc/SSHPlus/userteste/$nome.sh"
#!/bin/bash
pkill -u "$nome" >/dev/null 2>&1
userdel --force "$nome" >/dev/null 2>&1
sed -i "/^$nome[[:space:]]/d" /root/usuarios.db 2>/dev/null
rm -f "/etc/SSHPlus/senha/$nome" "/etc/SSHPlus/userteste/$nome.sh" >/dev/null 2>&1
exit 0
EOF

chmod +x "/etc/SSHPlus/userteste/$nome.sh"
at -f "/etc/SSHPlus/userteste/$nome.sh" "now + $u_temp min" >/dev/null 2>&1

clear
echo -e "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
echo -e "${C_GREEN}            ✓ USUÁRIO TESTE CRIADO COM SUCESSO!                  ${C_RESET}"
echo -e "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}\n"
echo -e "  ${C_YELLOW}IP / Host:${C_RESET}     ${C_WHITE}$IP${C_RESET}"
echo -e "  ${C_YELLOW}Usuário:${C_RESET}       ${C_WHITE}$nome${C_RESET}"
echo -e "  ${C_YELLOW}Senha:${C_RESET}         ${C_WHITE}$pass${C_RESET}"
echo -e "  ${C_YELLOW}Limite:${C_RESET}        ${C_WHITE}$limit conexão(ões)${C_RESET}"
echo -e "  ${C_YELLOW}Validade:${C_RESET}      ${C_GREEN}$u_temp minutos${C_RESET}\n"
echo -e "  ${C_WHITE}Após o tempo definido, o usuário será desconectado e apagado.${C_RESET}"
echo -e "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}\n"

echo -ne "${C_YELLOW}Pressione [ENTER] para voltar ao menu: ${C_RESET}"; read -r
menu
