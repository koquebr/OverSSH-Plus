#!/bin/bash
clear

C_RESET="\033[0m"
C_CYAN="\033[1;36m"
C_GREEN="\033[1;32m"
C_YELLOW="\033[1;33m"
C_RED="\033[1;31m"
C_WHITE="\033[1;37m"

echo -e "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
echo -e "${C_CYAN}                >>> RELATÓRIO GERAL DE USUÁRIOS <<<              ${C_RESET}"
echo -e "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
printf "  ${C_CYAN}%-16s %-14s %-12s %-16s${C_RESET}\n" "USUÁRIO" "SENHA" "LIMITE" "VALIDADE"
echo -e "${C_CYAN}─────────────────────────────────────────────────────────────────${C_RESET}"

total_contas=0
for users in $(awk -F: '$3 >= 500 { print $1 }' /etc/passwd | grep -v 'nobody' | grep -vi polkitd | grep -vi system- | sort); do
    total_contas=$((total_contas + 1))
    if [[ -f "$HOME/usuarios.db" ]] && grep -qw "$users" "$HOME/usuarios.db"; then
        lim=$(grep -w "$users" "$HOME/usuarios.db" | cut -d' ' -f2)
    else
        lim="1"
    fi

    if [[ -f "/etc/SSHPlus/senha/$users" ]]; then
        senha=$(cat "/etc/SSHPlus/senha/$users" 2>/dev/null)
    else
        senha="*****"
    fi

    datauser=$(chage -l "$users" 2>/dev/null | grep -i "Account expires" | cut -d: -f2)
    [[ -z "$datauser" ]] && datauser=$(chage -l "$users" 2>/dev/null | grep -i "expira" | cut -d: -f2)
    
    if [[ "$datauser" =~ "never" ]] || [[ "$datauser" =~ "nunca" ]] || [[ -z "$datauser" ]]; then
        data="${C_GREEN}Ilimitado${C_RESET}"
    else
        databr=$(date -d "$datauser" +"%Y%m%d" 2>/dev/null)
        hoje=$(date +"%Y%m%d")
        if [[ -n "$databr" && "$hoje" -ge "$databr" ]]; then
            data="${C_RED}Expirado${C_RESET}"
        else
            dat=$(date -d "$datauser" '+%Y-%m-%d' 2>/dev/null)
            dias_restantes=$(( ($(date -ud "$dat" +%s) - $(date -ud "$(date +%Y-%m-%d)" +%s)) / 86400 ))
            data="${C_YELLOW}${dias_restantes} dias${C_RESET}"
        fi
    fi

    printf "  ${C_WHITE}%-16s${C_RESET} ${C_YELLOW}%-14s${C_RESET} ${C_CYAN}%-12s${C_RESET} %b\n" "$users" "${senha:0:14}" "$lim" "$data"
done

# Estatísticas
online_ssh=$(ps -u $(awk -F: '$3 >= 500 {print $1}' /etc/passwd | tr '\n' ',' | sed 's/,$//') 2>/dev/null | grep sshd | wc -l)
online_drop=$(ps aux | grep dropbear | grep -v 'dropbear -p' | grep -v grep | wc -l)
online_total=$((online_ssh + online_drop))
expired_users=0
[[ -f /etc/SSHPlus/Exp ]] && expired_users=$(wc -l < /etc/SSHPlus/Exp 2>/dev/null || echo 0)

echo -e "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
printf "  ${C_WHITE}Total de Contas: ${C_YELLOW}%-6s${C_RESET} | ${C_WHITE}Online: ${C_GREEN}%-6s${C_RESET} | ${C_WHITE}Expirados: ${C_RED}%-6s${C_RESET}\n" "$total_contas" "$online_total" "$expired_users"
echo -e "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}\n"

echo -ne "${C_YELLOW}Pressione [ENTER] para voltar ao menu: ${C_RESET}"; read -r
menu
