#!/bin/bash
clear

C_RESET="\033[0m"
C_CYAN="\033[1;36m"
C_GREEN="\033[1;32m"
C_YELLOW="\033[1;33m"
C_RED="\033[1;31m"
C_WHITE="\033[1;37m"

echo -e "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
echo -e "${C_CYAN}               >>> ALTERAR VALIDADE / DATA DE EXPIRAÇÃO <<<       ${C_RESET}"
echo -e "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}\n"

list_user=$(awk -F: '$3 >= 500 {print $1}' /etc/passwd | grep -v 'nobody' | grep -vi polkitd | grep -vi system- | sort)
i=0
unset _userPass

while read -r user; do
    [[ -z "$user" ]] && continue
    i=$((i + 1))
    _oP=$i
    expire="$(chage -l "$user" 2>/dev/null | grep -E "Account expires" | cut -d: -f2)"
    [[ -z "$expire" ]] && expire="$(chage -l "$user" 2>/dev/null | grep -i "expira" | cut -d: -f2)"

    if [[ "$expire" =~ "never" || "$expire" =~ "nunca" || -z "$expire" ]]; then
        data_show="${C_GREEN}Ilimitado (Sem data)${C_RESET}"
    else
        databr=$(date -d "$expire" +"%Y%m%d" 2>/dev/null)
        hoje=$(date +"%Y%m%d")
        data_formatada=$(date -d "$expire" '+%d/%m/%Y' 2>/dev/null)
        if [[ -n "$databr" && "$hoje" -ge "$databr" ]]; then
            data_show="${C_RED}$data_formatada (Vencido)${C_RESET}"
        else
            data_show="${C_YELLOW}$data_formatada (Válido)${C_RESET}"
        fi
    fi

    printf "  ${C_CYAN}[%02d]${C_RESET} ${C_WHITE}•${C_RESET} ${C_YELLOW}%-18s${C_RESET} %b\n" "$i" "$user" "$data_show"
    _userPass+="\n${_oP}:${user}"
done <<< "${list_user}"

if [[ "$i" -eq 0 ]]; then
    echo -e "  ${C_RED}Nenhum usuário cadastrado no sistema.${C_RESET}\n"
    echo -ne "${C_YELLOW}Pressione [ENTER] para voltar: ${C_RESET}"; read -r
    menu
    exit 0
fi

echo -e "\n${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
echo -ne "${C_GREEN}Digite o número ou nome do usuário: ${C_WHITE}"
read -r option

if [[ "$option" =~ ^[0-9]+$ ]]; then
    usuario=$(echo -e "${_userPass}" | grep -E "^${option}:" | cut -d: -f2)
else
    usuario="$option"
fi

if [[ -n "$usuario" ]] && grep -qw "$usuario" /etc/passwd 2>/dev/null; then
    echo -ne "${C_GREEN}Adicionar quantos dias de validade a partir de hoje? [Ex: 30]: ${C_WHITE}"
    read -r dias
    [[ -z "$dias" || ! "$dias" =~ ^[0-9]+$ || "$dias" -lt 1 ]] && dias="30"

    nova_data=$(date -d "+$dias days" "+%Y-%m-%d")
    data_br=$(date -d "$nova_data" "+%d/%m/%Y")
    chage -E "$nova_data" "$usuario" 2>/dev/null

    echo -e "\n${C_GREEN}[✓] Validade do usuário '$usuario' atualizada para $data_br ($dias dias)!${C_RESET}\n"
else
    echo -e "\n${C_RED}[!] Usuário não encontrado ou opção inválida.${C_RESET}\n"
fi

sleep 2s
menu
