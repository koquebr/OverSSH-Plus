    echo -e "  ${C_CYAN}[08]${C_RESET} ${C_WHITE}•${C_RESET} ${C_RED}DESINSTALAR V2RAY / XRAY${C_RESET}"
    echo -e "  ${C_CYAN}[00]${C_RESET} ${C_WHITE}•${C_RESET} ${C_CYAN}VOLTAR AO MENU PRINCIPAL${C_RESET}"
    echo -e "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
    
    echo -ne "${C_GREEN}ESCOLHA UMA OPÇÃO: ${C_WHITE}"
    read opv

    case $opv in
        1|01) config_vmess ;;
        2|02) config_vless ;;
        3|03) config_reality ;;
        4|04) add_user_uuid ;;
        5|05) list_users ;;
        6|06)
            echo -ne "${C_YELLOW}Digite o UUID ou Usuário: ${C_WHITE}"
            read search_u
            found=$(grep "$search_u" "$USR_DB" | head -n1)
            if [[ -n "$found" ]]; then
                show_user_link $(echo "$found" | awk '{print $2}') $(echo "$found" | awk '{print $1}')
            else
                echo -e "${C_RED}Usuário/UUID não encontrado!${C_RESET}"
                sleep 2s
            fi
            ;;
        7|07) install_xray_core ;;
        8|08) uninstall_xray ;;
        0|00) break ;;
        *) echo -e "\n${C_RED}Opção inválida!${C_RESET}"; sleep 1s ;;
    esac
done
