#!/bin/bash
clear

C_RESET="\033[0m"
C_CYAN="\033[1;36m"
C_GREEN="\033[1;32m"
C_YELLOW="\033[1;33m"
C_RED="\033[1;31m"
C_WHITE="\033[1;37m"

local="/etc/bannerssh"

# Garante configuração no SSH e Dropbear
grep -q "Banner /etc/bannerssh" /etc/ssh/sshd_config || echo "Banner /etc/bannerssh" >> /etc/ssh/sshd_config
if [[ -f /etc/default/dropbear ]]; then
    grep -q 'DROPBEAR_BANNER="/etc/bannerssh"' /etc/default/dropbear || echo 'DROPBEAR_BANNER="/etc/bannerssh"' >> /etc/default/dropbear
fi

echo -e "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
echo -e "${C_CYAN}                 >>> GERENCIADOR DE BANNER SSH <<<               ${C_RESET}"
echo -e "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}\n"
echo -e "  ${C_CYAN}[01]${C_RESET} ${C_WHITE}•${C_RESET} ${C_GREEN}ADICIONAR / ALTERAR BANNER SSH${C_RESET}"
echo -e "  ${C_CYAN}[02]${C_RESET} ${C_WHITE}•${C_RESET} ${C_RED}REMOVER BANNER ATUAL${C_RESET}"
echo -e "  ${C_CYAN}[00]${C_RESET} ${C_WHITE}•${C_RESET} ${C_YELLOW}VOLTAR AO MENU PRINCIPAL${C_RESET}"
echo -e "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
echo -ne "${C_GREEN}Opção [1]: ${C_WHITE}"
read -e -i 1 resp

case $resp in
    1|01)
        echo -ne "\n${C_GREEN}Digite o texto que deseja exibir no Banner: ${C_WHITE}"
        read -r msg1
        if [[ -z "$msg1" ]]; then
            echo -e "\n${C_RED}[!] Mensagem vazia.${C_RESET}\n"
            sleep 1s
            menu
            exit 0
        fi

        echo -e "\n  ${C_CYAN}[01]${C_RESET} ${C_WHITE}AZUL${C_RESET}     ${C_CYAN}[02]${C_RESET} ${C_GREEN}VERDE${C_RESET}    ${C_CYAN}[03]${C_RESET} ${C_RED}VERMELHO${C_RESET}"
        echo -e "  ${C_CYAN}[04]${C_RESET} ${C_YELLOW}AMARELO${C_RESET}  ${C_CYAN}[05]${C_RESET} ${C_CYAN}CIANO${C_RESET}    ${C_CYAN}[06]${C_RESET} ${C_WHITE}SEM COR (PADRÃO)${C_RESET}"
        echo -ne "\n${C_GREEN}Escolha a cor do texto [5]: ${C_WHITE}"
        read -e -i 5 ban_cor

        case $ban_cor in
            1|01) cor="blue" ;;
            2|02) cor="green" ;;
            3|03) cor="red" ;;
            4|04) cor="yellow" ;;
            5|05) cor="cyan" ;;
            *) cor="" ;;
        esac

        if [[ -n "$cor" ]]; then
            echo "<h3><font color='$cor'>$msg1</font></h3>" > "$local"
        else
            echo "<h3>$msg1</h3>" > "$local"
        fi

        systemctl restart ssh >/dev/null 2>&1 || service ssh restart >/dev/null 2>&1
        systemctl restart dropbear >/dev/null 2>&1 || service dropbear restart >/dev/null 2>&1

        echo -e "\n${C_GREEN}[✓] Banner SSH configurado com sucesso!${C_RESET}\n"
        sleep 2s
        menu
        ;;
    2|02)
        > "$local"
        systemctl restart ssh >/dev/null 2>&1 || service ssh restart >/dev/null 2>&1
        systemctl restart dropbear >/dev/null 2>&1 || service dropbear restart >/dev/null 2>&1
        echo -e "\n${C_GREEN}[✓] Banner SSH removido com sucesso!${C_RESET}\n"
        sleep 2s
        menu
        ;;
    *)
        menu
        ;;
esac
