#!/bin/bash
clear

C_RESET="\033[0m"
C_CYAN="\033[1;36m"
C_GREEN="\033[1;32m"
C_YELLOW="\033[1;33m"
C_RED="\033[1;31m"
C_WHITE="\033[1;37m"

database="/root/usuarios.db"
[[ ! -f "$database" ]] && touch "$database"

fun_drop() {
    port_dropbear=$(ps aux | grep dropbear | awk 'NR==1 {print $17}' 2>/dev/null)
    log="/var/log/auth.log"
    loginsukses="Password auth succeeded"
    if [[ -f "$log" && -n "$port_dropbear" ]]; then
        pids=$(ps ax | grep dropbear | grep " $port_dropbear" | awk '{print $1}')
        for pid in $pids; do
            pidlogs=$(grep "$pid" "$log" 2>/dev/null | grep "$loginsukses" | awk '{print $3}')
            for pidend in $pidlogs; do
                login=$(grep "$pid" "$log" 2>/dev/null | grep "$pidend" | grep "$loginsukses")
                user=$(echo "$login" | awk '{print $10}' | sed -r "s/'//g")
                [[ -n "$user" ]] && echo "$user"
            done
        done
    fi
}

echo -e "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
echo -e "${C_CYAN}             >>> MONITOR DE CONEXÕES ATIVAS (SSH/VPN) <<<         ${C_RESET}"
echo -e "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
printf "  ${C_CYAN}%-16s %-14s %-16s %-12s${C_RESET}\n" "USUÁRIO" "STATUS" "CONEXÕES" "TEMPO"
echo -e "${C_CYAN}─────────────────────────────────────────────────────────────────${C_RESET}"

total_online=0
total_offline=0

while read -r usline || [[ -n "$usline" ]]; do
    [[ -z "$usline" ]] && continue
    user=$(echo "$usline" | awk '{print $1}')
    s2ssh=$(echo "$usline" | awk '{print $2}')
    [[ -z "$s2ssh" ]] && s2ssh="1"

    if grep -qw "$user" /etc/passwd 2>/dev/null; then
        sqd=$(ps -u "$user" 2>/dev/null | grep sshd | wc -l)
    else
        sqd=0
    fi

    if [[ -f /etc/openvpn/openvpn-status.log ]]; then
        ovp=$(grep -E -c ",$user," /etc/openvpn/openvpn-status.log 2>/dev/null || echo 0)
    else
        ovp=0
    fi

    if pgrep -x "dropbear" >/dev/null 2>&1; then
        drop=$(fun_drop | grep -c "$user" 2>/dev/null || echo 0)
    else
        drop=0
    fi

    conex=$((sqd + drop + ovp))

    if [[ $conex -gt 0 ]]; then
        total_online=$((total_online + 1))
        status="${C_GREEN}Online ●${C_RESET}"
        tst=$(ps -o etime $(ps -u "$user" 2>/dev/null | grep sshd | awk 'NR==1 {print $1}') 2>/dev/null | awk 'NR==2 {print $1}')
        [[ -z "$tst" ]] && timerr="00:00:00" || timerr="$tst"
    else
        total_offline=$((total_offline + 1))
        status="${C_RED}Offline ○${C_RESET}"
        timerr="--:--:--"
    fi

    printf "  ${C_WHITE}%-16s${C_RESET} %-23b ${C_YELLOW}%-16s${C_RESET} ${C_WHITE}%-12s${C_RESET}\n" "$user" "$status" "$conex/$s2ssh" "$timerr"
done < "$database"

echo -e "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
printf "  ${C_WHITE}Total Monitorados: ${C_YELLOW}%-4s${C_RESET} | ${C_GREEN}Online: %-4s${C_RESET} | ${C_RED}Offline: %-4s${C_RESET}\n" "$((total_online + total_offline))" "$total_online" "$total_offline"
echo -e "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}\n"

echo -ne "${C_YELLOW}Pressione [ENTER] para voltar ao menu: ${C_RESET}"; read -r
menu
