#!/bin/bash
clear

C_RESET="\033[0m"
C_CYAN="\033[1;36m"
C_GREEN="\033[1;32m"
C_YELLOW="\033[1;33m"
C_RED="\033[1;31m"
C_WHITE="\033[1;37m"

echo -e "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
echo -e "${C_CYAN}             >>> INFORMAÇÕES DETALHADAS DA VPS <<<               ${C_RESET}"
echo -e "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}\n"

# Sistema Operacional
os_name=$(cat /etc/issue.net 2>/dev/null || cat /etc/os-release | grep "PRETTY_NAME" | cut -d'"' -f2 | head -n1)
[[ -z "$os_name" ]] && os_name="Linux VPS"
kernel_v=$(uname -r)
arch_v=$(uname -m)

echo -e "${C_CYAN}• ${C_GREEN}SISTEMA OPERACIONAL${C_RESET}"
echo -e "  ${C_YELLOW}Nome:${C_RESET}       ${C_WHITE}$os_name${C_RESET}"
echo -e "  ${C_YELLOW}Kernel:${C_RESET}     ${C_WHITE}$kernel_v${C_RESET}"
echo -e "  ${C_YELLOW}Arquitetura:${C_RESET}${C_WHITE}$arch_v${C_RESET}\n"

# Processador
echo -e "${C_CYAN}• ${C_GREEN}PROCESSADOR (CPU)${C_RESET}"
cpu_model=$(grep -m1 "model name" /proc/cpuinfo 2>/dev/null | cut -d: -f2 | sed 's/^[ \t]*//')
[[ -z "$cpu_model" ]] && cpu_model="CPU Virtual / VPS"
cpu_cores=$(nproc 2>/dev/null || grep -c "^processor" /proc/cpuinfo 2>/dev/null || echo 1)
cpu_use=$(top -bn1 | awk '/Cpu/ { cpu = "" 100 - $8 "%" }; END { print cpu }' 2>/dev/null)
[[ -z "$cpu_use" ]] && cpu_use="0.0%"

echo -e "  ${C_YELLOW}Modelo:${C_RESET}     ${C_WHITE}$cpu_model${C_RESET}"
echo -e "  ${C_YELLOW}Núcleos:${C_RESET}    ${C_WHITE}$cpu_cores${C_RESET}"
echo -e "  ${C_YELLOW}Uso Atual:${C_RESET}  ${C_WHITE}$cpu_use${C_RESET}\n"

# Memória RAM
echo -e "${C_CYAN}• ${C_GREEN}MEMÓRIA RAM & REDE${C_RESET}"
ram_total=$(free -h | awk '/Mem:/ {print $2}')
ram_used=$(free -h | awk '/Mem:/ {print $3}')
ram_free=$(free -h | awk '/Mem:/ {print $4}')
bbr_status=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || echo "Desconhecido")

echo -e "  ${C_YELLOW}Total:${C_RESET}      ${C_WHITE}$ram_total${C_RESET}  |  ${C_YELLOW}Em Uso:${C_RESET} ${C_WHITE}$ram_used${C_RESET}  |  ${C_YELLOW}Livre:${C_RESET} ${C_WHITE}$ram_free${C_RESET}"
echo -e "  ${C_YELLOW}TCP BBR:${C_RESET}    ${C_GREEN}$bbr_status (Otimizado)${C_RESET}\n"

# Portas e Serviços
echo -e "${C_CYAN}• ${C_GREEN}SERVIÇOS E PORTAS EM EXECUÇÃO${C_RESET}"
PT=$(lsof -V -i tcp -P -n 2>/dev/null | grep -v "ESTABLISHED" | grep -v "COMMAND" | grep "LISTEN")
if [[ -n "$PT" ]]; then
    for porta in $(echo -e "$PT" | cut -d: -f2 | cut -d' ' -f1 | sort -nu); do
        svcs=$(echo -e "$PT" | grep -w "$porta" | awk '{print $1}' | uniq | head -n1)
        printf "  ${C_YELLOW}Serviço: ${C_WHITE}%-15s ${C_YELLOW}Porta: ${C_CYAN}%-10s${C_RESET}\n" "$svcs" "$porta"
    done
else
    echo -e "  ${C_WHITE}Nenhum serviço detectado no lsof.${C_RESET}"
fi

echo -e "\n${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
echo -ne "${C_YELLOW}Pressione [ENTER] para voltar ao menu: ${C_RESET}"; read -r
menu
