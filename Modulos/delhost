#!/bin/bash
clear

C_RESET="\033[0m"
C_CYAN="\033[1;36m"
C_GREEN="\033[1;32m"
C_YELLOW="\033[1;33m"
C_RED="\033[1;31m"
C_WHITE="\033[1;37m"

if [[ -d "/etc/squid" ]]; then
    payload="/etc/squid/payload.txt"
elif [[ -d "/etc/squid3" ]]; then
    payload="/etc/squid3/payload.txt"
else
    payload="/etc/squid/payload.txt"
fi

echo -e "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
echo -e "${C_CYAN}              >>> REMOVER HOST DO SQUID PROXY <<<                ${C_RESET}"
echo -e "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}\n"

if [[ ! -f "$payload" || ! -s "$payload" ]]; then
    echo -e "  ${C_RED}Nenhum host cadastrado no Squid Proxy.${C_RESET}\n"
    echo -ne "${C_YELLOW}Pressione [ENTER] para voltar: ${C_RESET}"; read -r
    menu
    exit 0
fi

echo -e "  ${C_YELLOW}Hosts cadastrados atualmente:${C_RESET}"
i=0
unset _hostList
while read -r hst; do
    [[ -z "$hst" ]] && continue
    i=$((i + 1))
    printf "  ${C_CYAN}[%02d]${C_RESET} ${C_WHITE}•${C_RESET} ${C_YELLOW}%s${C_RESET}\n" "$i" "$hst"
    _hostList+="\n${i}:${hst}"
done < "$payload"

echo -e "\n${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
echo -ne "${C_GREEN}Digite o número ou nome do host que deseja remover: ${C_WHITE}"
read -r option

if [[ "$option" =~ ^[0-9]+$ ]]; then
    alvo=$(echo -e "${_hostList}" | grep -E "^${option}:" | cut -d: -f2)
else
    alvo="$option"
fi

if [[ -n "$alvo" ]] && grep -q "^$alvo" "$payload" 2>/dev/null; then
    sed -i "/^$alvo$/d" "$payload"
    systemctl reload squid >/dev/null 2>&1 || systemctl reload squid3 >/dev/null 2>&1 || service squid reload >/dev/null 2>&1
    echo -e "\n${C_GREEN}[✓] Host '$alvo' removido com sucesso do Squid!${C_RESET}\n"
else
    echo -e "\n${C_RED}[!] Host não encontrado.${C_RESET}\n"
fi

sleep 2s
menu
