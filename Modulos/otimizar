#!/bin/bash
#====================================================
# OVER SSH PLUS - OTIMIZADOR DE SISTEMA & REDE
#====================================================
clear

# Cores
C_RESET="\033[0m"
C_CYAN="\033[1;36m"
C_GREEN="\033[1;32m"
C_YELLOW="\033[1;33m"
C_RED="\033[1;31m"
C_WHITE="\033[1;37m"

fun_bar() {
    comando[0]="$1"
    comando[1]="$2"
    (
        [[ -e $HOME/fim ]] && rm -f $HOME/fim
        ${comando[0]} -y >/dev/null 2>&1
        ${comando[1]} -y >/dev/null 2>&1
        touch $HOME/fim
    ) >/dev/null 2>&1 &
    tput civis
    echo -ne "   ${C_YELLOW}AGUARDE ${C_WHITE}- ${C_CYAN}["
    while true; do
        for ((i = 0; i < 18; i++)); do
            echo -ne "${C_GREEN}#"
            sleep 0.06s
        done
        [[ -e $HOME/fim ]] && rm -f $HOME/fim && break
        echo -e "${C_CYAN}]"
        sleep 1s
        tput cuu1
        tput dl1
        echo -ne "   ${C_YELLOW}AGUARDE ${C_WHITE}- ${C_CYAN}["
    done
    echo -e "${C_CYAN}]${C_WHITE} - ${C_GREEN}OK !${C_RESET}"
    tput cnorm
}

[[ $(grep -wc mlocate /var/lib/dpkg/statoverride 2>/dev/null) != '0' ]] && sed -i '/mlocate/d' /var/lib/dpkg/statoverride 2>/dev/null

clear
echo -e "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
echo -e "${C_GREEN}        OTIMIZAÇÃO AVANÇADA DE SISTEMA E REDE       ${C_RESET}"
echo -e "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}\n"

# Estatísticas Antes
MEM_ANTES=$(free | awk '/Mem:/ {print int(100*$3/$2)}')
ram_tot=$(free -h | grep -i mem | awk '{print $2}')
ram_livre_antes=$(free -h | grep -i mem | awk '{print $4}')
ram_uso_antes=$(free -h | grep -i mem | awk '{print $3}')

echo -e "${C_WHITE}RAM Total:${C_RESET} ${C_YELLOW}$ram_tot${C_RESET} | ${C_WHITE}Uso Atual:${C_RESET} ${C_RED}$ram_uso_antes ($MEM_ANTES%)${C_RESET} | ${C_WHITE}Livre:${C_RESET} ${C_GREEN}$ram_livre_antes${C_RESET}\n"

echo -e "${C_CYAN}[1/4]${C_WHITE} Limpando pacotes órfãos e corrigindo dependências...${C_RESET}"
fun_bar 'apt-get -f install' 'apt-get autoremove -y'
fun_bar 'apt-get autoclean -y' 'apt-get clean -y'

echo -e "\n${C_CYAN}[2/4]${C_WHITE} Purgando cache de memória RAM e Swap...${C_RESET}"
fun_limpram() {
    sync
    echo 3 > /proc/sys/vm/drop_caches
    sync && sysctl -w vm.drop_caches=3 >/dev/null 2>&1
    sysctl -w vm.drop_caches=0 >/dev/null 2>&1
    sysctl -w vm.swappiness=10 >/dev/null 2>&1
    swapoff -a >/dev/null 2>&1 && swapon -a >/dev/null 2>&1
    sleep 2
}
fun_bar 'fun_limpram'

echo -e "\n${C_CYAN}[3/4]${C_WHITE} Otimizando DNS Resolvers (Cloudflare 1.1.1.1 / Google 8.8.8.8)...${C_RESET}"
fun_dns() {
    cat << 'EOF' > /etc/resolv.conf
nameserver 1.1.1.1
nameserver 1.0.0.1
nameserver 8.8.8.8
nameserver 8.8.4.4
options timeout:2 attempts:2 rotate
EOF
}
fun_bar 'fun_dns'

echo -e "\n${C_CYAN}[4/4]${C_WHITE} Aplicando Aceleração Google BBR e Buffers TCP 64MB...${C_RESET}"
fun_bbr() {
    modprobe tcp_bbr >/dev/null 2>&1
    echo "tcp_bbr" >> /etc/modules-load.d/bbr.conf 2>/dev/null || echo "tcp_bbr" >> /etc/modules 2>/dev/null
    sed -i '/#SSHPLUS_TCP_BBR/,/#END_SSHPLUS_TCP_BBR/d' /etc/sysctl.conf 2>/dev/null
    
    cat << 'EOF' >> /etc/sysctl.conf

#SSHPLUS_TCP_BBR
net.core.default_qdisc = fq
net.ipv4.tcp_congestion_control = bbr
net.ipv4.tcp_fastopen = 3
net.ipv4.tcp_window_scaling = 1
net.ipv4.tcp_timestamps = 1
net.ipv4.tcp_sack = 1
net.ipv4.tcp_low_latency = 1
net.ipv4.tcp_slow_start_after_idle = 0
net.ipv4.tcp_mtu_probing = 1
net.core.rmem_max = 33554432
net.core.wmem_max = 33554432
net.core.rmem_default = 1048576
net.core.wmem_default = 1048576
net.core.optmem_max = 2048576
net.core.netdev_max_backlog = 65536
net.ipv4.tcp_rmem = 4096 87380 33554432
net.ipv4.tcp_wmem = 4096 65536 33554432
net.ipv4.tcp_max_syn_backlog = 16384
net.ipv4.tcp_max_tw_buckets = 2000000
net.ipv4.tcp_tw_reuse = 1
net.ipv4.tcp_fin_timeout = 15
net.ipv4.ip_local_port_range = 1024 65535
fs.file-max = 2097152
#END_SSHPLUS_TCP_BBR
EOF
    sysctl -p /etc/sysctl.conf >/dev/null 2>&1
}
fun_bar 'fun_bbr'

# Estatísticas Depois
MEM_DEPOIS=$(free | awk '/Mem:/ {print int(100*$3/$2)}')
ram_livre_depois=$(free -h | grep -i mem | awk '{print $4}')
ram_uso_depois=$(free -h | grep -i mem | awk '{print $3}')
bbr_status=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || echo "bbr")

clear
echo -e "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
echo -e "${C_GREEN}     ✓ SISTEMA E REDE OTIMIZADOS COM SUCESSO!       ${C_RESET}"
echo -e "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}\n"

echo -e "  ${C_WHITE}RAM Antes:  ${C_RED}$MEM_ANTES% (Em uso: $ram_uso_antes)${C_RESET}"
echo -e "  ${C_WHITE}RAM Agora:  ${C_GREEN}$MEM_DEPOIS% (Em uso: $ram_uso_depois | Livre: $ram_livre_depois)${C_RESET}"
if [[ "$MEM_ANTES" -ge "$MEM_DEPOIS" ]]; then
    echo -e "  ${C_WHITE}Economia:   ${C_GREEN}$((MEM_ANTES - MEM_DEPOIS))% de Memória Liberada!${C_RESET}"
fi
echo -e "  ${C_WHITE}Controle TCP Congestion: ${C_YELLOW}${bbr_status}${C_RESET} (${C_GREEN}Google BBR Ativo${C_RESET})"
echo -e "  ${C_WHITE}Algoritmo de Fila (Qdisc): ${C_YELLOW}$(sysctl -n net.core.default_qdisc 2>/dev/null || echo 'fq')${C_RESET}\n"

echo -e "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
echo -ne "${C_YELLOW}Pressione [ENTER] para voltar ao menu: ${C_RESET}"; read -r
menu
