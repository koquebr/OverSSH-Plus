#!/bin/bash
clear

C_RESET="\033[0m"
C_CYAN="\033[1;36m"
C_GREEN="\033[1;32m"
C_YELLOW="\033[1;33m"
C_RED="\033[1;31m"
C_WHITE="\033[1;37m"

echo -e "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
echo -e "${C_CYAN}         >>> GERENCIAR MEMÓRIA VIRTUAL (SWAP DE DISCO) <<<       ${C_RESET}"
echo -e "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}\n"

swap_total=$(free -h | awk '/Swap:/ {print $2}')
swap_used=$(free -h | awk '/Swap:/ {print $3}')
swap_free=$(free -h | awk '/Swap:/ {print $4}')

echo -e "  ${C_YELLOW}Status Atual do Swap:${C_RESET}"
echo -e "  ${C_WHITE}Total:${C_RESET} ${C_CYAN}$swap_total${C_RESET} | ${C_WHITE}Em Uso:${C_RESET} ${C_YELLOW}$swap_used${C_RESET} | ${C_WHITE}Livre:${C_RESET} ${C_GREEN}$swap_free${C_RESET}\n"

echo -e "  ${C_CYAN}[01]${C_RESET} ${C_WHITE}•${C_RESET} ${C_GREEN}CRIAR / ATIVAR MEMÓRIA SWAP (RECOMENDADO: 2GB A 4GB)${C_RESET}"
echo -e "  ${C_CYAN}[02]${C_RESET} ${C_WHITE}•${C_RESET} ${C_RED}DESATIVAR E REMOVER MEMÓRIA SWAP${C_RESET}"
echo -e "  ${C_CYAN}[00]${C_RESET} ${C_WHITE}•${C_RESET} ${C_YELLOW}VOLTAR AO MENU PRINCIPAL${C_RESET}"
echo -e "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
echo -ne "${C_GREEN}Opção: ${C_WHITE}"
read -r resposta

case $resposta in
    1|01)
        echo -ne "\n${C_GREEN}Quantos Gigabytes (GB) de Swap deseja criar? [Ex: 2]: ${C_WHITE}"
        read -r gigas
        [[ -z "$gigas" || ! "$gigas" =~ ^[0-9]+$ || "$gigas" -lt 1 ]] && gigas="2"

        echo -e "\n${C_CYAN}[+] Criando arquivo de swap de ${gigas}GB...${C_RESET}"
        swapoff -a >/dev/null 2>&1
        rm -f /swapfile /bin/ram.img >/dev/null 2>&1
        fallocate -l "${gigas}G" /swapfile 2>/dev/null || dd if=/dev/zero of=/swapfile bs=1M count=$((gigas * 1024)) >/dev/null 2>&1
        chmod 600 /swapfile
        mkswap /swapfile >/dev/null 2>&1
        swapon /swapfile >/dev/null 2>&1
        sysctl vm.swappiness=60 >/dev/null 2>&1
        
        grep -q "/swapfile" /etc/fstab || echo "/swapfile none swap sw 0 0" >> /etc/fstab
        echo -e "\n${C_GREEN}[✓] Memória Swap de ${gigas}GB ATIVADA com sucesso!${C_RESET}\n"
        sleep 2s
        menu
        ;;
    2|02)
        echo -e "\n${C_CYAN}[+] Desativando Swap...${C_RESET}"
        swapoff -a >/dev/null 2>&1
        rm -f /swapfile /bin/ram.img >/dev/null 2>&1
        sed -i '/swapfile/d' /etc/fstab 2>/dev/null
        sed -i '/ram.img/d' /etc/fstab 2>/dev/null
        echo -e "\n${C_GREEN}[✓] Swap desativado e removido!${C_RESET}\n"
        sleep 2s
        menu
        ;;
    *)
        menu
        ;;
esac
