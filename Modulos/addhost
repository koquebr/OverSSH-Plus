#!/bin/bash
clear

C_RESET="\033[0m"
C_CYAN="\033[1;36m"
C_GREEN="\033[1;32m"
C_YELLOW="\033[1;33m"
C_RED="\033[1;31m"
C_WHITE="\033[1;37m"

if [[ -d "/etc/squid" ]]; then
    payload="/etc/squid/payload.txt"
elif [[ -d "/etc/squid3" ]]; then
    payload="/etc/squid3/payload.txt"
else
    payload="/etc/squid/payload.txt"
    mkdir -p /etc/squid
    touch "$payload"
fi

echo -e "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
echo -e "${C_CYAN}             >>> ADICIONAR HOST AO SQUID PROXY <<<               ${C_RESET}"
echo -e "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}\n"

echo -e "  ${C_YELLOW}Hosts permitidos atualmente:${C_RESET}"
if [[ -f "$payload" && -s "$payload" ]]; then
    while read -r hst; do
        [[ -n "$hst" ]] && echo -e "  ${C_WHITE}• ${C_GREEN}$hst${C_RESET}"
    done < "$payload"
else
    echo -e "  ${C_WHITE}(Nenhum host cadastrado)${C_RESET}"
fi

echo -e "\n${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
echo -e "  ${C_WHITE}Dica: Digite o domínio começando com ponto (Ex: ${C_YELLOW}.vivo.com.br${C_WHITE})${C_RESET}\n"
echo -ne "${C_GREEN}Digite o domínio a ser adicionado: ${C_WHITE}"
read -r host

if [[ -z "$host" ]]; then
    echo -e "\n${C_RED}[!] Domínio vazio.${C_RESET}\n"
    sleep 1s
    menu
    exit 0
fi

[[ "$host" != .* ]] && host=".$host"

if grep -q "^$host" "$payload" 2>/dev/null; then
    echo -e "\n${C_YELLOW}[!] O domínio '$host' já existe na lista.${C_RESET}\n"
else
    echo "$host" >> "$payload"
    sort -u "$payload" -o "$payload"
    systemctl reload squid >/dev/null 2>&1 || systemctl reload squid3 >/dev/null 2>&1 || service squid reload >/dev/null 2>&1
    echo -e "\n${C_GREEN}[✓] Domínio '$host' adicionado com sucesso ao Squid!${C_RESET}\n"
fi

sleep 2s
menu
