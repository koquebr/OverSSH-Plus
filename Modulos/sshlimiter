#!/bin/bash
#====================================================
# OVER SSH PLUS - DAEMON LIMITER MULTILOGIN
#====================================================
database="/root/usuarios.db"
[[ ! -f "$database" ]] && awk -F: '$3 >= 500 {print $1 " 1"}' /etc/passwd | grep -v '^nobody' > "$database"

fun_multilogin() {
    while read -r user; do
        [[ -z "$user" ]] && continue
        if grep -q -w "$user" "$database" 2>/dev/null; then
            limit=$(grep -w "$user" "$database" | head -n1 | awk '{print $2}')
        else
            limit=1
        fi
        [[ -z "$limit" || "$limit" -le 0 ]] && limit=1

        # Conexões SSH
        conssh=$(ps -u "$user" 2>/dev/null | grep sshd | wc -l)
        
        # Conexões Dropbear
        condrop=$(ps aux | grep dropbear | grep -w "$user" | grep -v grep | wc -l)
        
        total_conn=$((conssh + condrop))

        if [[ "$total_conn" -gt "$limit" ]]; then
            # Desconecta o excesso
            pkill -u "$user" >/dev/null 2>&1
        fi

        # OpenVPN
        if [[ -f /etc/openvpn/openvpn-status.log ]]; then
            ovp=$(grep -c ",$user," /etc/openvpn/openvpn-status.log 2>/dev/null || echo 0)
            if [[ "$ovp" -gt "$limit" ]]; then
                pidokill=$((limit - ovp))
                listpid=$(grep ",$user," /etc/openvpn/openvpn-status.log | cut -d "," -f3 | head -n "$pidokill")
                while read -r ovpids; do
                    [[ -n "$ovpids" ]] && (telnet localhost 7505 <<< "kill $ovpids") >/dev/null 2>&1 &
                done <<< "$listpid"
            fi
        fi
    done <<< "$(awk -F: '$3 >= 500 {print $1}' /etc/passwd | grep -v 'nobody')"
}

while true; do
    fun_multilogin >/dev/null 2>&1
    sleep 10s
done
