#!/bin/bash
clear

C_RESET="\033[0m"
C_CYAN="\033[1;36m"
C_GREEN="\033[1;32m"
C_YELLOW="\033[1;33m"
C_RED="\033[1;31m"
C_WHITE="\033[1;37m"

datenow=$(date +%s)
database="/root/usuarios.db"

remove_ovp() {
    user="$1"
    if [[ -d /etc/openvpn/easy-rsa ]]; then
        cd /etc/openvpn/easy-rsa/ || return
        ./easyrsa --batch revoke "$user" >/dev/null 2>&1
        ./easyrsa gen-crl >/dev/null 2>&1
        rm -rf "pki/reqs/$user.req" "pki/private/$user.key" "pki/issued/$user.crt"
        cp -f /etc/openvpn/easy-rsa/pki/crl.pem /etc/openvpn/crl.pem 2>/dev/null
    fi
    rm -f "$HOME/$user.ovpn" "/var/www/html/openvpn/$user.zip" >/dev/null 2>&1
}

echo -e "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
echo -e "${C_CYAN}              >>> LIMPEZA DE USUÁRIOS EXPIRADOS <<<               ${C_RESET}"
echo -e "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
printf "  ${C_CYAN}%-16s %-14s %-12s %-16s${C_RESET}\n" "USUÁRIO" "EXPIRAÇÃO" "ESTADO" "AÇÃO"
echo -e "${C_CYAN}─────────────────────────────────────────────────────────────────${C_RESET}"

removidos=0

for user in $(awk -F: '$3 >= 500 {print $1}' /etc/passwd | grep -v 'nobody' | grep -vi polkitd | grep -vi system-); do
    expdate=$(chage -l "$user" 2>/dev/null | grep -i "Account expires" | cut -d: -f2)
    [[ -z "$expdate" ]] && expdate=$(chage -l "$user" 2>/dev/null | grep -i "expira" | cut -d: -f2)
    
    if [[ "$expdate" =~ "never" || "$expdate" =~ "nunca" || -z "$expdate" ]]; then
        continue
    fi

    datanormal=$(date -d "$expdate" '+%d/%m/%Y' 2>/dev/null)
    expsec=$(date +%s --date="$expdate" 2>/dev/null)
    
    if [[ -n "$expsec" && "$datenow" -ge "$expsec" ]]; then
        removidos=$((removidos + 1))
        pkill -u "$user" >/dev/null 2>&1
        userdel --force "$user" >/dev/null 2>&1
        sed -i "/^$user[[:space:]]/d" "$database" 2>/dev/null
        rm -f "/etc/SSHPlus/senha/$user" >/dev/null 2>&1
        remove_ovp "$user"
        printf "  ${C_WHITE}%-16s${C_RESET} ${C_YELLOW}%-14s${C_RESET} ${C_RED}%-12s${C_RESET} ${C_RED}%-16s${C_RESET}\n" "$user" "$datanormal" "VENCIDO" "REMOVIDO"
    else
        printf "  ${C_WHITE}%-16s${C_RESET} ${C_YELLOW}%-14s${C_RESET} ${C_GREEN}%-12s${C_RESET} ${C_WHITE}%-16s${C_RESET}\n" "$user" "$datanormal" "VÁLIDO" "MANTIDO"
    fi
done

echo '0' > /etc/SSHPlus/Exp 2>/dev/null
echo -e "\n${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
echo -e "  ${C_GREEN}Total de usuários expirados removidos: $removidos${C_RESET}"
echo -e "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}\n"

echo -ne "${C_YELLOW}Pressione [ENTER] para voltar ao menu: ${C_RESET}"; read -r
menu
