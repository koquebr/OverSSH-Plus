#!/bin/bash
clear

C_RESET="\033[0m"
C_CYAN="\033[1;36m"
C_GREEN="\033[1;32m"
C_YELLOW="\033[1;33m"
C_RED="\033[1;31m"
C_WHITE="\033[1;37m"

database="/root/usuarios.db"
[[ ! -f "$database" ]] && touch "$database"

remove_ovp() {
    user="$1"
    if [[ -d /etc/openvpn/easy-rsa ]]; then
        cd /etc/openvpn/easy-rsa/ || return
        ./easyrsa --batch revoke "$user" >/dev/null 2>&1
        ./easyrsa gen-crl >/dev/null 2>&1
        rm -rf "pki/reqs/$user.req" "pki/private/$user.key" "pki/issued/$user.crt"
        cp -f /etc/openvpn/easy-rsa/pki/crl.pem /etc/openvpn/crl.pem 2>/dev/null
    fi
    rm -f "$HOME/$user.ovpn" "/var/www/html/openvpn/$user.zip" >/dev/null 2>&1
}

echo -e "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
echo -e "${C_CYAN}                  >>> REMOVER USUÁRIOS SSH <<<                   ${C_RESET}"
echo -e "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}\n"
echo -e "  ${C_CYAN}[01]${C_RESET} ${C_WHITE}•${C_RESET} ${C_YELLOW}REMOVER UM USUÁRIO ESPECÍFICO${C_RESET}"
echo -e "  ${C_CYAN}[02]${C_RESET} ${C_WHITE}•${C_RESET} ${C_RED}REMOVER TODOS OS USUÁRIOS SSH${C_RESET}"
echo -e "  ${C_CYAN}[00]${C_RESET} ${C_WHITE}•${C_RESET} ${C_GREEN}VOLTAR AO MENU PRINCIPAL${C_RESET}"
echo -e "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
echo -ne "${C_GREEN}Opção desejada [1]: ${C_WHITE}"
read -e -i 1 resp

if [[ "$resp" = "1" || "$resp" = "01" ]]; then
    clear
    echo -e "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
    echo -e "${C_CYAN}                  >>> SELECIONE O USUÁRIO <<<                    ${C_RESET}"
    echo -e "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}\n"
    
    _userT=$(awk -F: '$3 >= 500 {print $1}' /etc/passwd | grep -v 'nobody' | grep -vi polkitd | grep -vi system- | sort)
    i=0
    unset _userPass
    while read -r _user; do
        [[ -z "$_user" ]] && continue
        i=$((i + 1))
        _oP=$i
        printf "  ${C_CYAN}[%02d]${C_RESET} ${C_WHITE}•${C_RESET} ${C_YELLOW}%s${C_RESET}\n" "$i" "$_user"
        _userPass+="\n${_oP}:${_user}"
    done <<< "${_userT}"

    if [[ "$i" -eq 0 ]]; then
        echo -e "  ${C_RED}Nenhum usuário SSH encontrado para remover.${C_RESET}\n"
        echo -ne "${C_YELLOW}Pressione [ENTER] para voltar: ${C_RESET}"; read -r
        menu
        exit 0
    fi

    echo -e "\n${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
    echo -ne "${C_GREEN}Digite o número ou o nome do usuário: ${C_WHITE}"
    read -r option

    if [[ "$option" =~ ^[0-9]+$ ]]; then
        user=$(echo -e "${_userPass}" | grep -E "^${option}:" | cut -d: -f2)
    else
        user="$option"
    fi

    if [[ -n "$user" ]] && grep -qw "$user" /etc/passwd 2>/dev/null; then
        pkill -u "$user" >/dev/null 2>&1
        userdel --force "$user" >/dev/null 2>&1
        sed -i "/^$user[[:space:]]/d" "$database" 2>/dev/null
        rm -f "/etc/SSHPlus/senha/$user" >/dev/null 2>&1
        remove_ovp "$user"
        echo -e "\n${C_GREEN}[✓] Usuário '$user' removido com sucesso!${C_RESET}\n"
    else
        echo -e "\n${C_RED}[!] Usuário não encontrado ou opção inválida.${C_RESET}\n"
    fi
    sleep 2s
    menu

elif [[ "$resp" = "2" || "$resp" = "02" ]]; then
    clear
    echo -e "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
    echo -e "${C_RED}         ATENÇÃO: REMOÇÃO DE TODOS OS USUÁRIOS SSH               ${C_RESET}"
    echo -e "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}\n"
    echo -ne "${C_RED}Tem certeza que deseja apagar TODOS os usuários? [s/N]: ${C_WHITE}"
    read -r confirma
    if [[ "$confirma" =~ ^[sS]$ ]]; then
        for _user in $(awk -F: '$3 >= 500 {print $1}' /etc/passwd | grep -v 'nobody' | grep -vi polkitd | grep -vi system-); do
            pkill -u "$_user" >/dev/null 2>&1
            userdel --force "$_user" >/dev/null 2>&1
            remove_ovp "$_user"
            rm -f "/etc/SSHPlus/senha/$_user" >/dev/null 2>&1
        done
        > "$database"
        echo -e "\n${C_GREEN}[✓] Todos os usuários foram removidos!${C_RESET}\n"
    else
        echo -e "\n${C_YELLOW}Operação cancelada.${C_RESET}\n"
    fi
    sleep 2s
    menu
else
    menu
fi
