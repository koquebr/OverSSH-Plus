#!/bin/bash
clear
[[ "$(whoami)" != "root" ]] && {
    echo -e "\033[1;33m[\033[1;31mErro\033[1;33m] \033[1;37m- \033[1;33mvocê precisa executar como root\033[0m"
    rm -f $HOME/Plus >/dev/null 2>&1
    exit 0
}

# --- CONFIGURAÇÃO AUTOMÁTICA DE SSH & ROOT ---
sed -i 's/.*PasswordAuthentication.*/PasswordAuthentication yes/g' /etc/ssh/sshd_config /etc/ssh/sshd_config.d/*.conf 2>/dev/null
sed -i 's/.*PermitRootLogin.*/PermitRootLogin yes/g' /etc/ssh/sshd_config /etc/ssh/sshd_config.d/*.conf 2>/dev/null
grep -q "PasswordAuthentication yes" /etc/ssh/sshd_config || echo "PasswordAuthentication yes" >> /etc/ssh/sshd_config
grep -q "PermitRootLogin yes" /etc/ssh/sshd_config || echo "PermitRootLogin yes" >> /etc/ssh/sshd_config
grep -q "KbdInteractiveAuthentication yes" /etc/ssh/sshd_config || echo "KbdInteractiveAuthentication yes" >> /etc/ssh/sshd_config 2>/dev/null
systemctl restart ssh >/dev/null 2>&1 || service ssh restart >/dev/null 2>&1

_lnk=$(echo 'z1:y#x.5s0ul&p4hs$s.0a72d*n-e!v89e032:3r' | sed -e 's/[^a-z.]//ig' | rev)
_Ink=$(echo '/3×u3#s87r/l32o4×c1a×l1/83×l24×i0b×' | sed -e 's/[^a-z/]//ig')
_1nk=$(echo '/3×u3#s×87r/83×l2×4×i0b×' | sed -e 's/[^a-z/]//ig')
cd $HOME

fun_bar() {
    comando[0]="$1"
    comando[1]="$2"
    (
        [[ -e $HOME/fim ]] && rm $HOME/fim
        ${comando[0]} -y >/dev/null 2>&1
        ${comando[1]} -y >/dev/null 2>&1
        touch $HOME/fim
    ) >/dev/null 2>&1 &
    tput civis
    echo -ne "  \033[1;36mAGUARDE \033[1;37m- \033[1;36m["
    while true; do
        for ((i = 0; i < 18; i++)); do
            echo -ne "\033[1;32m#"
            sleep 0.1s
        done
        [[ -e $HOME/fim ]] && rm $HOME/fim && break
        echo -e "\033[1;36m]"
        sleep 1s
        tput cuu1
        tput dl1
        echo -ne "  \033[1;36mAGUARDE \033[1;37m- \033[1;36m["
    done
    echo -e "\033[1;36m]\033[1;37m -\033[1;32m CONCLUÍDO !\033[1;37m"
    tput cnorm
}

function verif_key() {
    chmod +x $_Ink/list >/dev/null 2>&1
}

function verif_key2() {
    chmod +x $_Ink/listARM >/dev/null 2>&1
}

otimize_python() {
    apt-get install python3 -y >/dev/null 2>&1
    apt-get install python3-pip -y >/dev/null 2>&1
    apt-get install socat -y >/dev/null 2>&1
    apt-get install uuid-runtime -y >/dev/null 2>&1
    apt-get install curl jq -y >/dev/null 2>&1
}

echo -e "\033[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
echo -e "\033[1;36m   ██████  ██    ██ ███████ ██████      ███████ ███████ ██   ██\033[0m"
echo -e "\033[1;36m  ██    ██ ██    ██ ██      ██   ██     ██      ██      ██   ██\033[0m"
echo -e "\033[1;32m  ██    ██ ██    ██ █████   ██████      ███████ ███████ ███████\033[0m"
echo -e "\033[1;32m  ██    ██  ██  ██  ██      ██   ██          ██      ██ ██   ██\033[0m"
echo -e "\033[1;37m   ██████    ████   ███████ ██   ██     ███████ ███████ ██   ██\033[0m"
echo -e "\033[1;36m              >>> OVER SSH PLUS MANAGER <<<         \033[0m"
echo -e "\033[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
echo ""

if [[ "$OVER_UPDATE" != "1" ]]; then
    # --- PERGUNTA SENHA ROOT NA INSTALAÇÃO ---
    echo -ne "\033[1;33mDeseja configurar/alterar a senha ROOT agora? [S/n]: \033[1;37m"
    read -e -i "s" setroot
    if [[ "$setroot" =~ ^[sS]$ ]]; then
        echo -ne "\033[1;36mDigite a nova senha ROOT: \033[0m"
        read -s rootpass1
        echo ""
        echo -ne "\033[1;36mConfirme a nova senha ROOT: \033[0m"
        read -s rootpass2
        echo ""
        if [[ -n "$rootpass1" && "$rootpass1" == "$rootpass2" ]]; then
            (echo "$rootpass1"; echo "$rootpass1") | passwd root >/dev/null 2>&1
            echo -e "\033[1;32m[✓] Senha ROOT configurada com sucesso!\033[0m\n"
        else
            echo -e "\033[1;31m[!] Senhas não conferem ou em branco. Mantendo a atual.\033[0m\n"
        fi
    fi

    echo -e "\033[1;36mSelecione a Arquitetura da sua VPS: \033[1;37m"
    echo -e "\033[1;37m[\033[1;32m1\033[1;37m] - \033[1;36mx86_64 (Padrão)"
    echo -e "\033[1;37m[\033[1;32m2\033[1;37m] - \033[1;36maarch64 (ARM)\033[0m"
    echo -ne "\033[1;33mOpção [1]: \033[1;37m"
    read -e -i 1 resposta
else
    resposta=1
fi

mkdir -p $_Ink >/dev/null 2>&1
mkdir -p $_1nk >/dev/null 2>&1
mkdir -p /etc/SSHPlus >/dev/null 2>&1

sed -i 's/Port 22222/Port 22/g' /etc/ssh/sshd_config >/dev/null 2>&1
systemctl restart ssh >/dev/null 2>&1 || service ssh restart >/dev/null 2>&1

echo -e "\n\033[1;36mPREPARANDO AMBIENTE OVER SSH PLUS...\033[0m"

if [[ "$OVER_UPDATE" != "1" ]]; then
    [[ -f "$HOME/usuarios.db" ]] && {
        clear
        echo -e "\n\033[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
        echo -e "                 \033[1;33m• \033[1;32mBASE DE DADOS \033[1;33m• \033[0m"
        echo -e "\033[1;37mUma base de usuários \033[1;32m(usuarios.db)\033[1;37m foi encontrada!"
        echo -e "\n\033[1;37m[\033[1;32m1\033[1;37m] \033[1;33mManter Base de Dados Atual\033[0m"
        echo -e "\033[1;37m[\033[1;31m2\033[1;37m] \033[1;33mCriar uma Nova Base de Dados\033[0m"
        echo -e "\033[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
        read -p "Opção [1]: " -e -i 1 optiondb
    } || {
        awk -F : '$3 >= 500 { print $1 " 1" }' /etc/passwd | grep -v '^nobody' >$HOME/usuarios.db
    }
    [[ "$optiondb" = '2' ]] && awk -F : '$3 >= 500 { print $1 " 1" }' /etc/passwd | grep -v '^nobody' >$HOME/usuarios.db
else
    [[ ! -f "$HOME/usuarios.db" ]] && awk -F : '$3 >= 500 { print $1 " 1" }' /etc/passwd | grep -v '^nobody' >$HOME/usuarios.db
fi

clear
echo -e "\033[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
echo -e "\033[1;32m           ATUALIZANDO REPOSITÓRIOS E PACOTES       \033[0m"
echo -e "\033[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m\n"

fun_attlist() {
    apt-get update -y
    [[ ! -d /usr/share/.plus ]] && mkdir -p /usr/share/.plus
    echo "crz: $(date)" >/usr/share/.plus/.plus
}
fun_bar 'fun_attlist'

echo -e "\n\033[1;32mINSTALANDO DEPENDÊNCIAS ESSENCIAIS...\033[0m"
inst_pct() {
    _pacotes=("bc" "screen" "nano" "unzip" "lsof" "net-tools" "dos2unix" "nload" "jq" "curl" "figlet" "python3" "python3-pip" "socat" "at" "uuid-runtime")
    for _prog in ${_pacotes[@]}; do
        apt-get install $_prog -y >/dev/null 2>&1
    done
}
fun_bar 'inst_pct'

[[ -f "/usr/sbin/ufw" ]] && {
    ufw allow 22/tcp >/dev/null 2>&1
    ufw allow 80/tcp >/dev/null 2>&1
    ufw allow 443/tcp >/dev/null 2>&1
    ufw allow 3128/tcp >/dev/null 2>&1
    ufw allow 8799/tcp >/dev/null 2>&1
    ufw allow 8080/tcp >/dev/null 2>&1
}

echo -e "\n\033[1;32mCONFIGURANDO MÓDULOS E SERVIÇOS...\033[0m"
fun_bar 'otimize_python'

# Configuração do Repositório
DEFAULT_REPO_RAW="https://raw.githubusercontent.com/koquebr/OverSSH-Plus/master"
REPO_CONFIG="/etc/SSHPlus/repo.conf"
if [[ -f "$REPO_CONFIG" ]]; then
    REPO_RAW=$(cat "$REPO_CONFIG" 2>/dev/null | tr -d '\r\n')
fi
[[ -z "$REPO_RAW" ]] && REPO_RAW="$DEFAULT_REPO_RAW"
echo "$REPO_RAW" > /etc/SSHPlus/repo.conf

# Instalação dos scripts locais ou remotos do GitHub
if [[ ! -d "$HOME/SSHPLUS-master/Modulos" ]]; then
    mkdir -p "$HOME/SSHPLUS-master"
    wget -qO /tmp/sshplus.zip "https://github.com/koquebr/OverSSH-Plus/archive/refs/heads/master.zip" || wget -qO /tmp/sshplus.zip "https://github.com/koquebr/OverSSH-Plus/archive/refs/heads/main.zip"
    if [[ -s /tmp/sshplus.zip ]]; then
        unzip -qo /tmp/sshplus.zip -d /tmp/sshplus_extract >/dev/null 2>&1
        cp -rf /tmp/sshplus_extract/SSHPLUS-*/* "$HOME/SSHPLUS-master/" >/dev/null 2>&1
        rm -rf /tmp/sshplus.zip /tmp/sshplus_extract >/dev/null 2>&1
    fi
fi

if [[ -d "$HOME/SSHPLUS-master/Modulos" ]]; then
    cp -r $HOME/SSHPLUS-master/Modulos/* /bin/ >/dev/null 2>&1
    chmod +x /bin/* >/dev/null 2>&1
    cp -rf $HOME/SSHPLUS-master/Modulos/*.py /etc/SSHPlus/ >/dev/null 2>&1
    chmod +x /etc/SSHPlus/*.py >/dev/null 2>&1
    cp $HOME/SSHPLUS-master/Install/list $_Ink/list >/dev/null 2>&1
    chmod +x $_Ink/list >/dev/null 2>&1
fi

[[ ! -e /usr/bin/python ]] && ln -sf /usr/bin/python3 /usr/bin/python >/dev/null 2>&1

echo "/bin/menu" >/bin/h && chmod +x /bin/h >/dev/null 2>&1
echo "OVER_SSH_PLUS" >/usr/lib/licence >/dev/null 2>&1
echo "OVER_SSH_PLUS" >/usr/lib/sshplus >/dev/null 2>&1

# Executa lista de configuração de rede/serviços
if [[ -f "$_Ink/list" ]]; then
    bash $_Ink/list "$_lnk" "$_Ink" "$_1nk" "$key" >/dev/null 2>&1
elif [[ -f "$HOME/SSHPLUS-master/Install/list" ]]; then
    bash $HOME/SSHPLUS-master/Install/list "$_lnk" "$_Ink" "$_1nk" "$key" >/dev/null 2>&1
fi

clear
echo ""
echo -e "\033[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
echo -e "\033[1;32m      ✓ OVER SSH PLUS INSTALADO COM SUCESSO!        \033[0m"
echo -e "\033[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
echo ""
echo -e "\033[1;37mPara acessar o painel de gerenciamento, digite: \033[1;32mmenu\033[0m"
echo -e "\033[1;37mOu use o atalho rápido: \033[1;32mh\033[0m"
echo ""
echo -e "\033[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
rm -f $HOME/Plus >/dev/null 2>&1
